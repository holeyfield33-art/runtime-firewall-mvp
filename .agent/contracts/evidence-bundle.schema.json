{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence-bundle.schema.json",
  "title": "Evidence Bundle Entry",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "phase_id",
    "type",
    "command",
    "exit_code",
    "started_at",
    "ended_at",
    "cwd",
    "git_sha",
    "stdout_sha256",
    "stderr_sha256",
    "stdout_excerpt",
    "stderr_excerpt"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "phase_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["command"] },
    "command": { "type": "string", "minLength": 1 },
    "exit_code": { "type": "number" },
    "started_at": { "type": "string", "minLength": 1 },
    "ended_at": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "git_sha": { "type": "string", "minLength": 7 },
    "stdout_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "stderr_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "stdout_excerpt": { "type": "string" },
    "stderr_excerpt": { "type": "string" },
    "timed_out": { "type": "boolean" }
  }
}
