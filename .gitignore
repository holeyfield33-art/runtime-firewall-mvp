# .agent/ run artifacts are reproducible evidence dumps, not source — keep the directory
# structure and the P2-EXPERIMENT-001 proof run (checked in as graph-validity evidence), but
# ignore future/real run outputs by default (they can be regenerated by re-running the scripts).
.agent/runs/*
!.agent/runs/.gitkeep
!.agent/runs/exp001-*

